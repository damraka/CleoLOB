# Implementation hashes must survive Windows/Linux checkout conventions.
*.py text eol=lf
pyproject.toml text eol=lf
requirements.txt text eol=lf

# Research evidence preserves original bytes, including whitespace, for its seals.
examples/studies/** -text -whitespace
configs/core-study*.json -text

# v0.5 frozen protocol inputs are hashed byte-for-byte.
configs/v05/** text eol=lf
configs/v04-consumed-data.json text eol=lf
configs/v04-policy-study.json text eol=lf
